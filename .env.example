# Required: Pipefy API Bearer Token
# Generate at: Pipefy → Profile → Personal access tokens
PIPEFY_TOKEN=your_pipefy_token_here

# Required: Your Pipefy Organization ID
# Find via: curl -X POST https://api.pipefy.com/graphql \
#   -H "Authorization: Bearer YOUR_TOKEN" \
#   -H "Content-Type: application/json" \
#   -d '{"query":"{ me { organizations { id name } } }"}'
PIPEFY_ORG_ID=your_org_id_here

# Optional: Override API URL (default: https://api.pipefy.com/graphql)
# PIPEFY_API_URL=https://api.pipefy.com/graphql

# Optional: Log level (default: info)
# LOG_LEVEL=info

# Optional: Default page size for paginated queries (default: 50)
# PIPEFY_PAGE_SIZE=50

# Optional: Days threshold for stale cards (default: 5)
# PIPEFY_STALE_CARD_DAYS=5

# Optional: Hours threshold for SLA forecast (default: 24)
# PIPEFY_SLA_FORECAST_HOURS=24
